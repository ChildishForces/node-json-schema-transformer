{
  "name": "node-json-schema-transformer",
  "version": "0.1.0",
  "description": "Transform JSON Schema into native types and validation schemas for multiple languages",
  "main": "index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChildishForces/node-json-schema-transformer.git"
  },
  "license": "MIT",
  "keywords": [
    "json-schema",
    "zod",
    "typescript",
    "pydantic",
    "swift",
    "kotlin",
    "codegen",
    "napi-rs",
    "Rust",
    "node-addon"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "node-json-schema-transformer",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release --esm",
    "build:debug": "napi build --platform --esm",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "bun test __test__",
    "preversion": "napi build --platform --esm && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.5",
    "@emnapi/runtime": "^2.0.0-alpha.5",
    "@napi-rs/cli": "^3.9.1",
    "@napi-rs/wasm-runtime": "^1.2.4",
    "@oxc-node/core": "^0.1.2",
    "@tybys/wasm-util": "^0.10.4",
    "@types/bun": "^1.2.0",
    "chalk": "^6.0.0",
    "emnapi": "^2.0.0-alpha.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
